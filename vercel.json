{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "server.js" },
    { "source": "/user/(.*)", "destination": "server.js" },
    { "source": "/admin/(.*)", "destination": "server.js" },
    { "source": "/deposit/(.*)", "destination": "server.js" },
    { "source": "/game/(.*)", "destination": "server.js" },
    { "source": "/withdrawal/(.*)", "destination": "server.js" },
    { "source": "/(.*)", "destination": "public/$1" }
  ]
}